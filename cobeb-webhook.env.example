# Copie para /etc/cobeb-webhook.env (chmod 600). NÃO versione o arquivo real.
# Gere com: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio

# Formato exato proprietario/repositorio, separados por vírgula.
GITHUB_REPOSITORIES=unify-solucoes-que-conectam/cobeb-gestao-reposicao,unify-solucoes-que-conectam/cobeb-gestao-reposicao-api

# Campos "name:" exatos dos workflows que publicam as imagens.
GITHUB_WORKFLOW_NAMES=Publicar imagem Docker

GITHUB_BRANCH=main
DEPLOY_SCRIPT=/opt/cobeb/deploy.sh
DEPLOY_TIMEOUT_SECONDS=1800

# Escutar só na interface do Docker (docker0) evita expor a porta 9000 na internet.
# O Caddy em container alcança o host por host.docker.internal.
WEBHOOK_HOST=172.17.0.1
WEBHOOK_PORT=9000
