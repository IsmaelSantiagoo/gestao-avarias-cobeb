# Copie as variáveis atuais do Laravel e preserve principalmente APP_KEY e banco.
APP_NAME=Cobeb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cobeb.exemplo.com.br

# O compose sobrescreve estas variáveis com COBEB_DB_* do arquivo .env.
DB_CONNECTION=mysql
DB_HOST=cobeb-mysql
DB_PORT=3306
DB_DATABASE=cobeb
DB_USERNAME=cobeb
DB_PASSWORD=definida-pelo-compose

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

WHATSAPP_RATE_LIMIT_PER_MINUTE=10
EVOLUTION_DEFAULT_NUMBER=
