# Modelo de produção. Copie para /opt/cobeb/.env na VPS e preencha.
FRONTEND_IMAGE_TAG=develop
API_IMAGE_TAG=develop

# Domínios PÚBLICOS (o DNS de cada um deve apontar para o IP da VPS)
APP_DOMAIN=cobeb.suaempresa.com.br
API_DOMAIN=api.cobeb.suaempresa.com.br
REVERB_DOMAIN=reverb.cobeb.suaempresa.com.br
EVOLUTION_DOMAIN=whatsapp.cobeb.suaempresa.com.br
ACME_EMAIL=ti@suaempresa.com.br

# Gere cada valor com: openssl rand -hex 32
REVERB_APP_KEY=
EVOLUTION_MASTER_KEY=
META_WEBHOOK_VERIFY_TOKEN=

# Senhas SOMENTE alfanuméricas (sem símbolos): openssl rand -hex 24
COBEB_DB_NAME=cobeb
COBEB_DB_USER=cobeb
COBEB_DB_PASSWORD=
COBEB_DB_ROOT_PASSWORD=

EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution
